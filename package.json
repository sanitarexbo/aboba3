{
  "name": "finesse-crm",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node --experimental-strip-types server/src/index.ts",
    "build": "tsc --project web/tsconfig.json && vite build",
    "start": "node --experimental-strip-types server/src/index.ts",
    "create-owner": "node --experimental-strip-types server/src/index.ts create-owner",
    "reset-password": "node --experimental-strip-types server/src/index.ts reset-password",
    "test:api": "node --experimental-strip-types tests/api.test.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
